# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard). .env.local is
# git-ignored, so real values never get committed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used to build the email confirmation redirect link. Use your deployed
# URL in production (e.g. https://billtracker.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (VAPID). Generate your own with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Project Settings > API > service_role in the Supabase dashboard. Secret —
# bypasses Row Level Security. Only used server-side, in the reminders cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the reminders cron route checks against Vercel Cron's
# request before running. Generate your own, e.g. `openssl rand -hex 32`.
CRON_SECRET=your-random-secret
